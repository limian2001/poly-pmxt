# ===== pmxt 行情栈配置 =====
# 复制为 .env 后按需修改： cp .env.example .env

# 宿主机映射端口。避开 homerun 的 3000/8000。
PMXT_PORT=3200

# 绑哪个地址。两种用法二选一：
#   127.0.0.1 → 只能从服务器本机访问，靠 SSH 隧道进来（默认，最安全）
#   0.0.0.0   → 公网 IP:3200 直接访问，不用挂隧道
# 选 0.0.0.0 的话，还得在云厂商安全组里放行 3200 端口，并且 **必须** 设下面的 PMXT_AUTH。
PMXT_BIND=127.0.0.1

# 访问口令，格式 用户名:密码。留空 = 不校验。
# 走隧道时留空没问题（隧道本身就是认证）；绑 0.0.0.0 时留空等于把这两样白送给全网：
#   · POST /api/board/refresh —— 每次真的去打托管接口，烧的是你的 credit
#   · /pmxt/*                —— pmxt-core 的完整 REST，等于一台免费行情代理
# 用的是 HTTP Basic：浏览器原生弹框，之后 fetch 和 SSE 都会自动带上，前端不用改。
# 生成一个够长的密码：  openssl rand -base64 18
PMXT_AUTH=

# 前端展示哪些平台（逗号分隔，纯行情只读、无需凭据）
# 可选：polymarket, kalshi, limitless, opinion, probable, myriad,
#       metaculus, smarkets, baozi, hyperliquid, gemini-titan, suibets, rain, hunch
# 注意：opinion 直连行情需要它自己的 API key（大盘直连会 401）；它在「跨平台匹配」页
#       仍可显示（走 pmxt 托管目录）。大盘默认不含 opinion。
PMXT_VENUES=polymarket,kalshi,limitless

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# pmxt 托管匹配引擎的 API key（免费档即可，pmxt.dev/dashboard 申请）
# 用于「跨平台同一市场」的精准匹配与套利扫描。留空则该视图不可用，其余行情照常。
# 网关会在服务端把它注入为 Bearer，不会暴露到浏览器。
PMXT_API_KEY=


# ===== 行情台（大盘）配置 =====
# 这一栈的核心取舍：**结构向托管接口买，价格从直连免费拿**。
# 托管接口只用来回答「这三家的哪几条是同一个标的」，一次同步几十个 credit；
# 价格、涨跌、成交额、盘口、K 线、成交明细全部直连各平台，**不花一个 credit**。
# 所以下面这些参数里，只有「同步间隔」和「事件条数」跟额度有关，其余随便调。

# 目录同步间隔（毫秒）。默认 15 分钟。
# 免费档 25000 credit/月：15 分钟一轮，一个月大约用掉三四千，很宽裕。
# 想更实时不必调这里 —— 价格本来就是 WebSocket 推的，这个只管「有哪些标的」。
PMXT_BOARD_SYNC_MS=900000

# 每轮从锚定平台拉多少个事件。1200 覆盖 Polymarket 绝大部分活跃盘。
# 调大 → 内存和同步耗时线性增长；调小 → 冷门标的会从大盘上消失。
PMXT_BOARD_EVENT_LIMIT=1200

# Polymarket 单独的上限。Gamma 的 /events 有 offset 天花板，超了返回 422
# "offset too large, use /events/keyset for deeper pagination"。
# 2026-07 实测：offset 1500 / 2000 → 200，3000 / 5000 → 422，天花板在 (2000, 3000) 之间。
# 2000 条事件对应最深 offset 1900，留了一页余量。
#
# ⚠️ 真正生效的是 min(PMXT_BOARD_EVENT_LIMIT, PMXT_POLY_MAX_EVENTS)。
#    只抬这一个不会让主榜变长 —— 想要更多行，得连上面的 EVENT_LIMIT 一起抬。
#
# 上限会变（Gamma 在推 /events/keyset），**调大之前先自己探一次**：
#   for o in 1500 2000 2500 3000; do printf '%s ' $o; curl -s -o /dev/null -w '%{http_code}\n' \
#     "https://gamma-api.polymarket.com/events?limit=100&offset=$o&active=true&closed=false"; done
# 最后一个返回 200 的 offset 减掉一两百，就是这里能填的安全值。
# 事件是按成交量降序拿的，所以砍掉的一定是最冷的那批。
PMXT_POLY_MAX_EVENTS=2000

# 锚定平台：所有标的以它为准，其他平台来匹配它。
# 换成别家之前先想清楚 —— 它的事件结构（Series/Event/Market/Outcome）决定了整张表的骨架。
PMXT_BOARD_ANCHOR=polymarket

# 目录快照落盘位置。容器里由 compose 的 pmxt-data 卷提供，一般不用改。
# 作用是重启后先把上一轮的数据显示出来，别让用户对着空表等一分钟。
PMXT_BOARD_SNAPSHOT=/data/board.json

# 托管接口地址，除非 pmxt 官方改域名，否则别动
# PMXT_HOSTED_BASE=https://api.pmxt.dev


# ===== 实时推送 =====
# Polymarket / Limitless 走公开 WebSocket（真推送），Kalshi 的 watchOrderBook 要鉴权，
# 所以 Kalshi 单独走轮询。全部直连，同样不花 credit。

# 总开关。设 0 则退化为「每 60 秒整页重取一次」，页面还能用，只是不跳动。
PMXT_RT_ENABLED=1

# 同时盯多少个结果（按热度取最前面的）。
# 往上调更实时，但每个订阅都是一条真实连接/一次轮询，200 以内比较稳妥。
PMXT_RT_MAX_SUBS=160

# Kalshi 轮询间隔（毫秒）与并发。它没法推送，只能这样。
PMXT_RT_POLL_MS=20000
PMXT_RT_POLL_CONCURRENCY=4

# 多久按最新热度重新对一次订阅表（毫秒）
PMXT_RT_RESUB_MS=60000

# 前端合帧间隔（毫秒）：同一个格子在这个窗口里跳 10 次也只推最后一次，
# 免得 600 行的表被刷爆。调到 100 以下前端会明显吃力。
PMXT_RT_FLUSH_MS=400


# ===== 直连接口的缓存时间（毫秒）=====
# 盘口/K线/成交都是点一下才拉，这几个 TTL 防的是「鼠标扫过一行打十几个请求」。
PMXT_BOOK_TTL_MS=5000
PMXT_CANDLE_TTL_MS=60000
PMXT_TRADE_TTL_MS=15000


# ===== 运维状态条 =====
# 宿主机 cron 写的 status.json 所在目录（compose 以只读挂进 /app/ops）
PMXT_OPS_DIR=/home/ubuntu/ops
# 上面是「宿主机哪个目录」，下面是「容器里读哪个文件」，两者成对出现。
# 默认 /app/ops/status.json 已经和 compose 的挂载点对上了，一般不用动。
# PMXT_OPS_FILE=/app/ops/status.json


# ---- 以下为「私有数据」可选项：纯看行情不需要 ----
# 只有当你要看账户余额/持仓/自己的成交时才填对应平台凭据。
# pmxt-core 会自动读取这些环境变量。
# ⚠️ Kalshi 那个是 KALSHI_API_KEY_ID，不是 KALSHI_API_KEY（venues.mjs 按前者判断）。
#    名字写错不会报错，只是「私有数据」一直悄悄关着，很难查。
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY=


# ===== 标题中译（腾讯云机器翻译 TMT）=====
# 不填就是整个功能关掉：看板照常跑，标题保持英文原文，不会报错。
# 凭据在腾讯云「访问管理 → API 密钥管理」创建，建议用子账号并只授予
# QcloudTMTFullAccess 一条策略 —— 这把 key 只用来翻标题，没必要给它别的权限。
# ⚠️ 和 PMXT_API_KEY 一样：只在服务端持有，绝不会下发到浏览器。
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# 就近选个地域即可，翻译质量与地域无关，只影响延迟
# TENCENT_REGION=ap-guangzhou

# 译文缓存文件（落在 pmxt-data 卷里，重启不丢）。
# 按**原文**缓存而不是按行缓存：标题几周都不变，真正要翻的只有新上的盘，
# 所以第一轮之后每轮只有几十条新增，字符消耗几乎可以忽略。
# 想强制重翻（比如改了术语表）就删掉这个文件再重启。
# PMXT_I18N_CACHE=/data/i18n-zh.json

# 限流参数：官方文档站是 SPA 抓不到准确配额，所以默认取小值，撞到限流会自动退避。
# 你的账号额度更宽的话把这几个调大，翻译会快很多，代码不用动。
# PMXT_TR_BATCH=20             # 一次请求最多几条
# PMXT_TR_BATCH_CHARS=1800     # 一次请求最多多少字符（和上面谁先到算谁）
# PMXT_TR_GAP_MS=1000          # 两次请求之间歇多久
# PMXT_TR_MAX_PER_ROUND=3000   # 一轮同步最多翻多少条，防止某天平台换一大批盘把免费额度烧穿

# ===== Polymarket 官方中文（免费，不需要任何 key）=====
# Gamma 接口带上 locale 就会返回中文标题，和 polymarket.com 中文站看到的一模一样。
# 实测覆盖：事件标题 92%、标签 91%、候选名 38%。没覆盖到的才会送去腾讯云机翻，
# 所以这一层直接砍掉大半的翻译字符消耗 —— 没配腾讯云的话，光靠它也能有九成标题是中文。
# PMXT_POLY_LOCALE=zh          # 想看繁体改 zh-TW
# PMXT_POLY_ZH_MAX=1200        # 最多拉多少个事件的对照（Gamma 的 offset 有上限，别调太大）

# ===== 只读模式（把看板开给外人看时用）=====
# 摘掉 PMXT_AUTH 之前先把这个打开：访客只能 GET 看板，碰不到会花钱或能被白嫖的接口。
#   挡掉 POST /api/board/refresh（每次都真去打托管接口，烧 credit）
#   挡掉 /pmxt/*（pmxt-core 的完整 REST，等于免费送人一台行情代理）
#   挡掉 /gw/diag（内部路径和接口地址，没必要给外人）
# 和 PMXT_AUTH 是正交的：带对口令的请求不受限制，所以「自己有全权、外人只读」也能同时成立。
# PMXT_PUBLIC_READONLY=1
