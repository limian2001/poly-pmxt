# ===== pmxt 行情栈配置 =====
# 复制为 .env 后按需修改： cp .env.example .env

# 宿主机映射端口（只绑 127.0.0.1，靠 SSH 隧道访问）。避开 homerun 的 3000/8000。
PMXT_PORT=3200

# 前端展示哪些平台（逗号分隔，纯行情只读、无需凭据）
# 可选：polymarket, kalshi, limitless, opinion, probable, myriad,
#       metaculus, smarkets, baozi, hyperliquid, gemini-titan, suibets, rain, hunch
PMXT_VENUES=polymarket,kalshi,limitless,opinion

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# ---- 以下为「私有数据」可选项：纯看行情不需要 ----
# 只有当你要看账户余额/持仓/自己的成交时才填对应平台凭据。
# pmxt-core 会自动读取这些环境变量。
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
# KALSHI_API_KEY=
# KALSHI_PRIVATE_KEY=
