# ===== pmxt 行情栈配置 =====
# 复制为 .env 后按需修改： cp .env.example .env

# 宿主机映射端口（只绑 127.0.0.1，靠 SSH 隧道访问）。避开 homerun 的 3000/8000。
PMXT_PORT=3200

# 前端展示哪些平台（逗号分隔，纯行情只读、无需凭据）
# 可选：polymarket, kalshi, limitless, opinion, probable, myriad,
#       metaculus, smarkets, baozi, hyperliquid, gemini-titan, suibets, rain, hunch
# 注意：opinion 直连行情需要它自己的 API key（大盘直连会 401）；它在「跨平台匹配」页
#       仍可显示（走 pmxt 托管目录）。大盘默认不含 opinion。
PMXT_VENUES=polymarket,kalshi,limitless

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# pmxt 托管匹配引擎的 API key（免费档即可，pmxt.dev/dashboard 申请）
# 用于「跨平台同一市场」的精准匹配与套利扫描。留空则该视图不可用，其余行情照常。
# 网关会在服务端把它注入为 Bearer，不会暴露到浏览器。
PMXT_API_KEY=

# ---- 以下为「私有数据」可选项：纯看行情不需要 ----
# 只有当你要看账户余额/持仓/自己的成交时才填对应平台凭据。
# pmxt-core 会自动读取这些环境变量。
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
# KALSHI_API_KEY=
# KALSHI_PRIVATE_KEY=
